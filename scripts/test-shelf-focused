#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
test_root=$(mktemp -d /private/tmp/atoll-shelf-focused-tests.XXXXXX)

cleanup() {
  find "$test_root" -type f -delete
  find "$test_root" -depth -type d -empty -delete
}
trap cleanup EXIT

swiftc \
  -parse-as-library \
  "$repo_root/tests/test_shelf_file_drag_contract.swift" \
  -o "$test_root/test_shelf_file_drag_contract"
"$test_root/test_shelf_file_drag_contract"
