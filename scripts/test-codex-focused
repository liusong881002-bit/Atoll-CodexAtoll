#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
test_root=$(mktemp -d /private/tmp/atoll-codex-focused-tests.XXXXXX)

cleanup() {
  find "$test_root" -type f -delete
  find "$test_root" -depth -type d -empty -delete
}
trap cleanup EXIT

core_sources=(
  "$repo_root/DynamicIsland/Features/Codex/Core/JSONValue.swift"
  "$repo_root/DynamicIsland/Features/Codex/Core/CodexHookEvent.swift"
  "$repo_root/DynamicIsland/Features/Codex/Core/CodexHookEnvelope.swift"
  "$repo_root/DynamicIsland/Features/Codex/Core/PreviewSanitizer.swift"
  "$repo_root/DynamicIsland/Features/Codex/Core/CodexTaskModels.swift"
  "$repo_root/DynamicIsland/Features/Codex/Core/CodexEventReducer.swift"
)

swiftc \
  "${core_sources[@]}" \
  "$repo_root/DynamicIsland/Features/Codex/Presentation/CodexActivityTrayModel.swift" \
  "$repo_root/tests/test_codex_status_reconciliation.swift" \
  -o "$test_root/test_codex_status_reconciliation"
"$test_root/test_codex_status_reconciliation"

swiftc \
  "${core_sources[@]}" \
  "$repo_root/tests/test_codex_completion_acknowledgement.swift" \
  -o "$test_root/test_codex_completion_acknowledgement"
"$test_root/test_codex_completion_acknowledgement"

swiftc \
  "$repo_root/DynamicIsland/Features/Codex/Core/PreviewSanitizer.swift" \
  "$repo_root/DynamicIsland/Features/Codex/Core/CodexTaskModels.swift" \
  "$repo_root/DynamicIsland/Features/Codex/Presentation/CodexActivityTrayModel.swift" \
  "$repo_root/tests/test_codex_activity_tray_completion_deduplication.swift" \
  -o "$test_root/test_codex_activity_tray_completion_deduplication"
"$test_root/test_codex_activity_tray_completion_deduplication"

swiftc \
  "$repo_root/DynamicIsland/Features/Codex/Presentation/CodexConstants.swift" \
  "$repo_root/DynamicIsland/Features/Codex/Presentation/CodexSneakPeekPresentationPolicy.swift" \
  "$repo_root/DynamicIsland/models/SneakPeekPresentationTokenPolicy.swift" \
  "$repo_root/tests/test_codex_sneak_peek_presentation.swift" \
  -o "$test_root/test_codex_sneak_peek_presentation"
"$test_root/test_codex_sneak_peek_presentation"

swiftc \
  "$repo_root/DynamicIsland/sizing/NotchTabSizeSynchronizationPolicy.swift" \
  "$repo_root/tests/test_notch_tab_size_synchronization.swift" \
  -o "$test_root/test_notch_tab_size_synchronization"
"$test_root/test_notch_tab_size_synchronization"

swiftc \
  "$repo_root/DynamicIsland/sizing/StandaloneCalendarLayoutPolicy.swift" \
  "$repo_root/tests/test_standalone_calendar_layout.swift" \
  -o "$test_root/test_standalone_calendar_layout"
"$test_root/test_standalone_calendar_layout"
